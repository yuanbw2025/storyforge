    {
      "path": "kokoro/model.py",
      "sha256": "f50aa4583fbeb6b1b70cbb53941cf354deb363a27b30fab4955c2696ea02b986",
      "edits": [
        {
          "old": "        for key, state_dict in torch.load(model, map_location='cpu', weights_only=True).items():\n            assert hasattr(self, key), key\n            try:\n                getattr(self, key).load_state_dict(state_dict)\n            except:\n                logger.debug(f\"Did not load {key} from state_dict\")\n                state_dict = {k[7:]: v for k, v in state_dict.items()}\n                getattr(self, key).load_state_dict(state_dict, strict=False)\n",
          "new": "        weights = torch.load(model, map_location='cpu', weights_only=True)\n        expected = {'bert', 'bert_encoder', 'predictor', 'text_encoder', 'decoder'}\n        if set(weights) != expected: raise ValueError('Unexpected model components')\n        for key, state_dict in weights.items():\n            if all(k.startswith('module.') for k in state_dict):\n                state_dict = {k[7:]: v for k, v in state_dict.items()}\n            getattr(self, key).load_state_dict(state_dict, strict=True)\n"
        },
        {
          "old": "        indices = torch.repeat_interleave",
          "new": "        if not torch.isfinite(duration).all() or int(pred_dur.sum()) > 3000:\n            raise ValueError('Predicted speech exceeds fixed evaluation limit')\n        indices = torch.repeat_interleave"
        },
        {
          "old": "        input_ids = list(filter(lambda i: i is not None, map(lambda p: self.vocab.get(p), phonemes)))",
          "new": "        if any(p not in self.vocab for p in phonemes): raise ValueError('Unknown phoneme; do not drop text')\n        input_ids = [self.vocab[p] for p in phonemes]"
        }
      ]
    },
