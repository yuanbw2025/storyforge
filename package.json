{
  "name": "storyforge",
  "private": true,
  "version": "4.0.5",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "avg:local-foreground": "bash scripts/avg-local-foreground/start.sh",
    "docs:dev": "vitepress dev website-docs",
    "docs:build": "vitepress build website-docs",
    "docs:preview": "vitepress preview website-docs",
    "build": "tsc -b && tsc -p ui-preview/tsconfig.json && npm run build:adventure-player && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "node scripts/run-isolated-coverage.mjs",
    "test:e2e": "npm run build:adventure-player && playwright test",
    "test:e2e:product-performance": "PRODUCTPROD_PERF_MODE=smoke playwright test tests/e2e/product-production-performance.spec.ts --project=chromium",
    "test:e2e:product-performance-gates": "PRODUCTPROD_PERF_MODE=smoke PRODUCTPROD_PERF_QUALITY=commercial playwright test tests/e2e/product-production-performance.spec.ts --project=chromium",
    "test:e2e:product-performance:commercial": "PLAYWRIGHT_FROZEN_WORKSPACE=1 PRODUCTPROD_PERF_MODE=commercial playwright test tests/e2e/product-production-performance.spec.ts --project=chromium",
    "check:required-tables": "node scripts/check-required-tables.mjs",
    "check:source-reachability": "node scripts/check-source-reachability.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:dependencies": "npm run check:desktop-runtime && npm audit --omit=dev --audit-level=moderate",
    "check:desktop-runtime": "node scripts/distribution/check-desktop-runtime.mjs",
    "check:release-metadata": "node scripts/check-release-metadata.mjs",
    "check:docs": "node scripts/check-document-authority.mjs && node scripts/check-independent-creation-plans.mjs && npm run plugins:check-kit",
    "check:roadmap": "node scripts/check-roadmap.mjs",
    "check:agent-context": "node scripts/check-agent-context.mjs",
    "check:agent-freshness": "node scripts/check-agent-freshness.mjs",
    "check:canon-coverage": "node scripts/check-canon-coverage.mjs",
    "gen:project-metrics": "node scripts/generate-project-metrics.mjs",
    "check:project-metrics": "node scripts/generate-project-metrics.mjs --check",
    "gen:ai-manual": "node scripts/generate-ai-manual.mjs",
    "check:ai-manual": "node scripts/generate-ai-manual.mjs --check",
    "check:ai-entry-registry": "node scripts/check-ai-entry-registry.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:narrative-world": "node scripts/check-narrative-world-baseline.mjs",
    "test:narrative-world:baseline": "node scripts/run-narrative-world-baseline.mjs",
    "eval:narrative-world:author-quality": "node scripts/evaluate-narrative-author-quality-local-codex.mjs",
    "check:text-open-world-player-paths": "node scripts/check-text-open-world-player-paths.mjs",
    "check:text-open-world-invariants": "node scripts/check-text-open-world-invariants.mjs",
    "check:text-open-world-stress": "node scripts/check-text-open-world-stress.mjs",
    "check:text-open-world-performance": "node scripts/check-text-open-world-performance.mjs",
    "check:text-open-world-calibration": "node scripts/check-text-open-world-calibration.mjs",
    "check:text-open-world-human-playtest": "node scripts/check-text-open-world-human-playtest.mjs",
    "check:text-open-world-release-update": "node scripts/check-text-open-world-release-update.mjs",
    "check:text-open-world-lifecycle": "node scripts/check-text-open-world-lifecycle.mjs",
    "check:text-open-world-retirement": "node scripts/check-text-open-world-retirement.mjs",
    "test:text-open-world:g7-paths:contracts": "vitest run tests/regression/R-OPEN-WORLD2-player-definition.test.ts tests/regression/R-OPEN-WORLD2-end-to-end.test.ts tests/regression/R-OPEN-WORLD4-inventory-panel.test.tsx tests/regression/R-OPEN-WORLD2-economy.test.ts tests/regression/R-OPEN-WORLD2-quest-state-machine.test.ts tests/regression/R-OPEN-WORLD4-player-quest-log.test.ts tests/regression/R-OPEN-WORLD2-quest-tracking-history.test.ts tests/regression/R-OPEN-WORLD2-travel.test.ts tests/regression/R-OPEN-WORLD2-fast-travel.test.ts tests/regression/R-OPEN-WORLD2-crime.test.ts tests/regression/R-OPEN-WORLD2-life-cycle.test.ts tests/regression/R-OPEN-WORLD2-protected-quest-unlock-v18.test.ts tests/regression/R-OPEN-WORLD4-player-version-compatibility.test.ts",
    "test:text-open-world:g7-paths:e2e": "PLAYWRIGHT_FROZEN_WORKSPACE=1 playwright test tests/e2e/text-open-world-scene-interactions.spec.ts tests/e2e/text-open-world-combat.spec.ts tests/e2e/text-open-world-crafting-economy.spec.ts tests/e2e/text-open-world-complete-journey.spec.ts tests/e2e/text-open-world-save-settings.spec.ts --project=chromium",
    "test:text-open-world:g7-paths": "npm run check:text-open-world-player-paths && npm run test:text-open-world:g7-paths:contracts && npm run test:text-open-world:g7-paths:e2e",
    "test:text-open-world:g7-invariants": "npm run check:text-open-world-invariants && vitest run tests/regression/R-OPEN-WORLD7-fixed-seed-invariants.test.ts tests/regression/R-OPEN-WORLD2-inventory.test.ts tests/regression/R-OPEN-WORLD2-economy.test.ts tests/regression/R-OPEN-WORLD2-quest-state-machine.test.ts tests/regression/R-OPEN-WORLD2-actor-lifecycle.test.ts tests/regression/R-OPEN-WORLD2-command-envelope.test.ts tests/regression/R-OPEN-WORLD2-event-protocol.test.ts tests/regression/R-OPEN-WORLD2-end-to-end.test.ts tests/regression/R-OPEN-WORLD4-player-resilience.test.ts tests/regression/R-OPEN-WORLD2-release-session-binding.test.ts tests/regression/R-OPEN-WORLD2-player-definition.test.ts",
    "test:text-open-world:g7-stress": "npm run check:text-open-world-stress && vitest run tests/regression/R-OPEN-WORLD7-long-run-stress.test.ts tests/regression/R-OPEN-WORLD2-director.test.ts tests/regression/R-OPEN-WORLD2-quest-tracking-history.test.ts tests/regression/R-OPEN-WORLD2-protected-quest-unlock-v18.test.ts",
    "test:text-open-world:g7-performance:contracts": "vitest run tests/regression/R-OPEN-WORLD7-large-state-performance.test.ts tests/regression/R-PRODUCT-RUNTIME1-core.test.ts tests/regression/R-CURRENT-SCHEMA-single-baseline.test.ts tests/registry/project-tables.test.ts",
    "test:text-open-world:g7-performance:e2e": "PLAYWRIGHT_FROZEN_WORKSPACE=1 playwright test tests/e2e/text-open-world-large-state-performance.spec.ts --project=chromium",
    "test:text-open-world:g7-performance": "npm run check:text-open-world-performance && npm run test:text-open-world:g7-performance:contracts && npm run test:text-open-world:g7-performance:e2e",
    "test:text-open-world:g7-calibration": "npm run check:text-open-world-calibration && vitest run tests/regression/R-OPEN-WORLD7-release-calibration.test.ts tests/regression/R-OPEN-WORLD7-calibration-lineage.test.ts tests/regression/R-OPEN-WORLD5-creator-quality.test.ts tests/regression/R-OPEN-WORLD5-creator-quality-ui.test.tsx",
    "test:text-open-world:g7-human-playtest": "npm run check:text-open-world-human-playtest && vitest run tests/regression/R-OPEN-WORLD5-creator-quality.test.ts tests/regression/R-OPEN-WORLD5-creator-quality-ui.test.tsx",
    "test:text-open-world:g7-release-update": "npm run check:text-open-world-release-update && vitest run tests/regression/R-OPEN-WORLD5-creator-quality.test.ts tests/regression/R-OPEN-WORLD5-creator-quality-ui.test.tsx tests/regression/R-OPEN-WORLD5-save-migration.test.ts tests/regression/R-OPEN-WORLD5-creator-artifact-repair.test.ts",
    "test:text-open-world:g7-lifecycle": "npm run check:text-open-world-lifecycle && vitest run tests/regression/R-OPEN-WORLD7-release-lifecycle.test.ts tests/regression/R-OPEN-WORLD5-creator-lifecycle.test.ts tests/regression/R-OPEN-WORLD5-save-migration.test.ts tests/regression/R-OPEN-WORLD2-registry-lifecycle.test.ts tests/regression/R-PRODUCTPROD1A1-production-lifecycle.test.ts tests/regression/R-PRODUCTPROD1I-quality-receipts.test.ts tests/regression/R-PRODUCTPROD1A2-media-blob-store.test.ts",
    "test:text-open-world:g7-retirement": "npm run check:text-open-world-retirement && vitest run tests/regression/R-PRODUCTPROD1G-product-adapters.test.ts tests/regression/R-PRODUCTPROD1G-product-quality.test.ts tests/regression/R-OPEN-WORLD2-release-session-binding.test.ts tests/regression/R-OPEN-WORLD4-player-shell-integration.test.tsx tests/regression/R-OPEN-WORLD4-player-legacy-resilience-ui.test.tsx tests/regression/R-OPEN-WORLD4-player-saves-legacy.test.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test:codex-bridge": "node --test scripts/local-codex/*.test.mjs",
    "ci": "npm run test:codex-bridge && npm run check:required-tables && npm run check:ai-manual && npm run check:ai-entry-registry && npm run check:architecture && npm run check:text-open-world-player-paths && npm run check:text-open-world-invariants && npm run check:text-open-world-stress && npm run check:text-open-world-performance && npm run check:text-open-world-calibration && npm run check:text-open-world-human-playtest && npm run check:text-open-world-release-update && npm run check:text-open-world-lifecycle && npm run check:text-open-world-retirement && npm run check:source-reachability && npm run check:docs && npm run check:roadmap && npm run check:agent-context && npm run check:agent-freshness && npm run check:canon-coverage && npm run check:project-metrics && npm run check:dependencies && npm run lint && npx tsc --noEmit && npm run test:coverage && npm run build && npm run check:bundle-size",
    "ci:e2e": "PLAYWRIGHT_FROZEN_WORKSPACE=1 npm run test:e2e",
    "plugins:build-examples": "node tools/plugin-sdk/build-examples.mjs",
    "plugins:check": "node tools/plugin-sdk/cli.mjs check",
    "plugins:build-kit": "node tools/plugin-sdk/build-developer-kit.mjs",
    "plugins:check-kit": "node tools/plugin-sdk/build-developer-kit.mjs --check && node --test tools/plugin-sdk/catalog-entries.test.mjs",
    "build:showcase": "tsc -b && npm run build:adventure-player && vite build --mode showcase",
    "test:showcase": "playwright test --config playwright.showcase.config.ts",
    "build:adventure-player": "node scripts/build-adventure-player.mjs",
    "build:portable": "tsc -b && tsc -p ui-preview/tsconfig.json && npm run build:adventure-player && vite build --mode portable",
    "test:distribution": "node --test scripts/distribution/*.test.mjs",
    "build:windows": "npm run build:portable && node scripts/distribution/notices.mjs && electron-builder --config electron-builder.config.cjs --win --x64 --publish never",
    "desktop:dev": "npm run build:portable && electron scripts/desktop/main.mjs",
    "build:android:web": "tsc -b && npm run build:adventure-player && vite build --mode android && node scripts/distribution/prepare-android.mjs && cap sync android",
    "build:android": "npm run build:android:web && node scripts/distribution/build-android.mjs",
    "test:clients": "node --test scripts/desktop/*.test.mjs scripts/distribution/*.test.mjs && vitest run tests/regression/R-CLIENT-native-transport.test.ts tests/regression/R-CLIENT-updates.test.tsx tests/regression/R-CLIENT-save-file.test.ts tests/regression/R-CLIENT-SUPPORT1-feedback-telemetry.test.tsx tests/regression/R-CLIENT-LEGAL1-consent.test.tsx",
    "build:macos": "npm run build:portable && node scripts/distribution/notices.mjs && electron-builder --config electron-builder.config.cjs --mac --publish never --config.directories.output=release/macos"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/ext-tasks": "0.2.2",
    "@noble/hashes": "2.4.0",
    "@tiptap/core": "3.31.0",
    "@tiptap/extension-placeholder": "3.31.0",
    "@tiptap/extension-text-style": "3.31.0",
    "@tiptap/pm": "3.31.0",
    "@tiptap/react": "3.31.0",
    "@tiptap/starter-kit": "3.31.0",
    "@types/d3-hierarchy": "^3.1.7",
    "d3-hierarchy": "^3.1.2",
    "delaunator": "^5.1.0",
    "dexie": "^4.0.11",
    "electron-updater": "6.8.9",
    "hash-wasm": "4.12.0",
    "json5": "^2.2.3",
    "jsonrepair": "^3.15.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "1.12.2",
    "marked": "^15.0.12",
    "nanoid": "^5.1.16",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-force-graph-2d": "^1.29.1",
    "react-router": "^8.3.0",
    "three": "0.183.2",
    "turndown": "^7.2.0",
    "yaml": "^2.4.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.183.1",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "electron": "44.10.0",
    "electron-builder": "26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^20.10.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.61.1",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "mammoth": {
      "argparse": "2.0.1"
    }
  }
}
